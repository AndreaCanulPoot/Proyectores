@{
    ViewData["Title"] = "Inicio";
}

<div class="container">
    <div class="text-start">
        <h1 class="display-4">Información de Proyectores</h1>
        <h2 class="display-6">Proyector # @ViewData["id"]</h2>
        <p>Marca: @ViewData["Marca"]</p>
        <p>Modelo: @ViewData["Modelo"]</p>
        <p>Número de serie: @ViewData["NSerie"]</p>
        <p>Situación: @ViewData["Situacion"]</p>
        <p>Fecha de alta: @ViewData["FechaAlta"]</p>
    </div>
</div>
