@model Proyector
@{
    ViewData["Title"] = "Nuevo Proyector";
}

<div class="container">
    <h1 class="display-5 mb-3">Nuevo Proyector</h1>
    <div class="row">
        <form asp-controller="Home" asp-action="Create">
            <div class="form-group mb-3">
                <label class="form-label" asp-for="Id">Número de Proyetor:</label>
                <input type="number" class="form-control" asp-for="Id" id="Id"/>
            </div>

            <div class="form-group mb-3">
                <label class="form-label" asp-for="Marca">Marca del Proyector:</label>
                <input type="text" class="form-control" asp-for="Marca" id="Marca"/>
            </div>

            <div class="form-group mb-3">
                <label class="form-label" asp-for="Modelo">Modelo:</label>
                <input type="text" class="form-control" asp-for="Modelo" id="Modelo"/>
            </div>

            <div class="form-group mb-3">
                <label class="form-label" asp-for="NSerie">Número de serie:</label>
                <input type="number" class="form-control" asp-for="NSerie" id="Numero de serie"/>
            </div>

            <div class="form-group mb-3">
                <label class="form-label" asp-for="FechaAlta">Fecha de Alta:</label>
                <input type="date" class="form-control" asp-for="FechaAlta" id="Fecha de Alta"/>
            </div>

            <div class="form-group mb-3">
               <label class="form-label" asp-for="Situacion">Situación del Proyector:</label>
               <select class="form-select" asp-for="Situacion" id="Situacion">
                   <option value="1">Bueno</option>
                   <option value="2">Regular</option>
                   <option value="3">Malo</option>
               </select>
            </div>

            <div class="form-group mb-3">
                <buttom type="submit" class="btn btn-primary">Guardar</buttom>
                <a class="btn btn-secondary" asp_controller="Home" asp-action="Index">Cancelar</a>
            </div>

        </form>
    </div>
</div>